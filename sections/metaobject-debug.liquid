{%- comment -%}
  This section is for debugging metaobjects in the theme editor.
  It will only be visible in the theme editor, not on the live site.
{%- endcomment -%}

{% if request.design_mode %}
<div class="metaobject-debug" {{ section.shopify_attributes }}>
  <style>
    .metaobject-debug {
      padding: 20px;
      margin: 20px 0;
      background: #f8f9fa;
      border: 1px solid #dee2e6;
      border-radius: 4px;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }
    .metaobject-debug h2 {
      margin-top: 0;
      font-size: 1.4em;
    }
    .metaobject-debug h3 {
      margin-top: 1.5em;
      font-size: 1.2em;
    }
    .metaobject-debug pre {
      background: #f1f3f5;
      padding: 10px;
      border-radius: 4px;
      overflow: auto;
      font-family: monospace;
      font-size: 13px;
    }
    .metaobject-debug table {
      width: 100%;
      border-collapse: collapse;
      margin: 1em 0;
    }
    .metaobject-debug th, .metaobject-debug td {
      border: 1px solid #dee2e6;
      padding: 8px;
      text-align: left;
    }
    .metaobject-debug th {
      background: #e9ecef;
    }
    .metaobject-debug .success {
      color: #28a745;
    }
    .metaobject-debug .error {
      color: #dc3545;
    }
  </style>

  <h2>Metaobject Debug Panel</h2>
  
  <h3>Metaobject Definitions</h3>
  <table>
    <tr>
      <th>Type</th>
      <th>Exists</th>
      <th>Count</th>
    </tr>
    <tr>
      <td>metaobjects.brand</td>
      <td>{% if metaobjects.brand %}✅ Yes{% else %}❌ No{% endif %}</td>
      <td>{{ metaobjects.brand.size }}</td>
    </tr>
    <tr>
      <td>metaobjects.Brand</td>
      <td>{% if metaobjects.Brand %}✅ Yes{% else %}❌ No{% endif %}</td>
      <td>{{ metaobjects.Brand.size }}</td>
    </tr>
  </table>
  
  <h3>All Metaobject Types in Store</h3>
  <ul>
    {% for type in metaobjects %}
      <li>{{ type }}</li>
    {% endfor %}
  </ul>
  
  <h3>Brand Metaobject Entries (metaobjects.brand)</h3>
  {% if metaobjects.brand.size > 0 %}
    <table>
      <tr>
        <th>ID</th>
        <th>Handle</th>
        <th>Type</th>
        <th>Fields</th>
      </tr>
      {% for brand in metaobjects.brand %}
        <tr>
          <td>{{ brand.id }}</td>
          <td>{{ brand.handle }}</td>
          <td>{{ brand.type }}</td>
          <td>
            <details>
              <summary>View Fields</summary>
              <ul>
                <li>title: {% if brand.title.value %}{{ brand.title.value }}{% else %}Not set{% endif %}</li>
                <li>brand_handle: {% if brand.brand_handle.value %}{{ brand.brand_handle.value }}{% else %}Not set{% endif %}</li>
                <li>menu_handle: {% if brand.menu_handle.value %}{{ brand.menu_handle.value }}{% else %}Not set{% endif %}</li>
                <li>image: {% if brand.image.reference %}Has image{% else %}No image{% endif %}</li>
                <li>link: {% if brand.link.value %}{{ brand.link.value }}{% else %}Not set{% endif %}</li>
                <li>is_active: {% if brand.is_active.value %}{{ brand.is_active.value }}{% else %}Not set{% endif %}</li>
              </ul>
            </details>
          </td>
        </tr>
      {% endfor %}
    </table>
  {% else %}
    <p class="error">No brand metaobjects found.</p>
  {% endif %}
  
  <h3>Brand Metaobject Entries (metaobjects.Brand)</h3>
  {% if metaobjects.Brand.size > 0 %}
    <table>
      <tr>
        <th>ID</th>
        <th>Handle</th>
        <th>Type</th>
        <th>Fields</th>
      </tr>
      {% for brand in metaobjects.Brand %}
        <tr>
          <td>{{ brand.id }}</td>
          <td>{{ brand.handle }}</td>
          <td>{{ brand.type }}</td>
          <td>
            <details>
              <summary>View Fields</summary>
              <ul>
                <li>title: {% if brand.title.value %}{{ brand.title.value }}{% else %}Not set{% endif %}</li>
                <li>brand_handle: {% if brand.brand_handle.value %}{{ brand.brand_handle.value }}{% else %}Not set{% endif %}</li>
                <li>menu_handle: {% if brand.menu_handle.value %}{{ brand.menu_handle.value }}{% else %}Not set{% endif %}</li>
                <li>image: {% if brand.image.reference %}Has image{% else %}No image{% endif %}</li>
                <li>link: {% if brand.link.value %}{{ brand.link.value }}{% else %}Not set{% endif %}</li>
                <li>is_active: {% if brand.is_active.value %}{{ brand.is_active.value }}{% else %}Not set{% endif %}</li>
              </ul>
            </details>
          </td>
        </tr>
      {% endfor %}
    </table>
  {% else %}
    <p class="error">No Brand metaobjects found.</p>
  {% endif %}
  
  <h3>Direct Access Test</h3>
  <pre>
    {%- capture direct_access_test -%}
      {% for brand in metaobjects.brand %}
        Brand ID: {{ brand.id }}
        Brand Type: {{ brand.type }}
        Brand Handle: {{ brand.handle }}
        Title: {{ brand.title.value }}
        Brand Handle: {{ brand.brand_handle.value }}
        Menu Handle: {{ brand.menu_handle.value }}
        Has Image: {% if brand.image.reference %}Yes{% else %}No{% endif %}
        Link: {{ brand.link.value }}
        Is Active: {{ brand.is_active.value }}
        ---
      {% endfor %}
    {%- endcapture -%}
    {{ direct_access_test | strip }}
  </pre>
</div>
{% endif %}

{% schema %}
{
  "name": "Metaobject Debug",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Metaobject Debug"
    }
  ]
}
{% endschema %}
