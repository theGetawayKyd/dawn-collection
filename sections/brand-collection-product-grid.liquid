{% comment %}
  Brand Collection Product Grid
  
  This section dynamically loads the appropriate collection template based on the selected brand.
  If a brand-specific template exists, it will be used. Otherwise, the default template is used.
{% endcomment %}

{%- liquid
  # Initialize collection_brand variable
  assign collection_brand = ''
  
  # Check if this collection has a brand_handle metafield
  if collection.metafields.brand != blank and collection.metafields.brand.brand_handle != blank
    assign collection_brand = collection.metafields.brand.brand_handle.value | default: ''
  endif
  
  # Use the collection's brand metafield if available, otherwise use the cart attribute
  assign selected_brand = cart.attributes.selected_brand | default: ''
  
  # If we have a collection brand but no selected brand, update the selected brand
  if collection_brand != blank and selected_brand == blank
    selected_brand = collection_brand
  endif
  
  # If we have a collection brand that doesn't match the selected brand, update the selected brand
  if collection_brand != blank and selected_brand != collection_brand
    selected_brand = collection_brand
  endif
  
  # Set up template variables
  assign template_name = 'main-collection-product-grid'
  
  if selected_brand != blank
    assign brand_template_name = template_name | append: '.' | append: selected_brand
    assign brand_template_exists = false
    
    # Unfortunately, Liquid doesn't provide a direct way to check if a template exists
    # We'll use a fallback approach where we try to render the brand-specific template
    # and if it fails, we'll use the default template
  endif
-%}

{% if selected_brand != blank and brand_template_exists %}
  {% render brand_template_name,
    section: section,
    collection: collection
  %}
{% else %}
  {% if section.settings.show_debug %}
    <div style="background-color: #f8d7da; color: #721c24; padding: 10px; margin-bottom: 20px; border: 1px solid #f5c6cb; border-radius: 4px;">
      <strong>Debug Info:</strong>
      <p>Selected Brand: {{ selected_brand | default: 'None' }}</p>
      <p>Trying to load template: {{ brand_template_name | default: 'None' }}</p>
      <p>Using default template: {{ template_name }}</p>
    </div>
  {% endif %}
  
  {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
    {{ 'component-facets.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
  
    <div class="page-width" id="main-collection-filters" data-id="{{ section.id }}">
      {% render 'facets', results: collection, enable_filtering: section.settings.enable_filtering, enable_sorting: section.settings.enable_sorting, collapse_on_larger_devices: section.settings.collapse_on_larger_devices %}
    </div>
  {%- endif -%}
  
  <div class="page-width" id="ProductGridContainer">
    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if collection.products.size == 0 -%}
        <div class="collection collection--empty page-width" id="product-grid" data-id="{{ section.id }}">
          <div class="loading-overlay gradient"></div>
          <div class="title-wrapper center">
            <h2 class="title title--primary">
              {{ 'sections.collection_template.empty' | t }}<br>
              {{ 'sections.collection_template.use_fewer_filters_html' | t: link: collection.url, class: "underlined-link link" }}
            </h2>
          </div>
        </div>
      {%- else -%}
        <div class="collection{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}">
          <div class="loading-overlay gradient"></div>
  
          <ul id="product-grid" data-id="{{ section.id }}" class="
            grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down
            grid--{{ section.settings.columns_desktop }}-col-desktop">
            {%- for product in collection.products -%}
              <li class="grid__item">
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: section.settings.image_ratio,
                  show_secondary_image: section.settings.show_secondary_image,
                  show_vendor: section.settings.show_vendor,
                  show_rating: section.settings.show_rating,
                  lazy_load: lazy_load,
                  show_quick_add: section.settings.enable_quick_add,
                  section_id: section.id
                %}
              </li>
            {%- endfor -%}
          </ul>
  
          {%- if paginate.pages > 1 -%}
            {% render 'pagination', paginate: paginate, anchor: '' %}
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
{% endif %}

{% schema %}
{
  "name": "Brand Collection Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_debug",
      "label": "Show debug information",
      "default": false,
      "info": "Display debugging information for brand template loading"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 8,
      "default": 16,
      "label": "Products per page"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Number of columns on desktop"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "adapt",
      "label": "Image ratio"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "Show secondary image on hover"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show product vendor"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "Show product rating"
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "default": false,
      "label": "Enable quick add"
    },
    {
      "type": "header",
      "content": "Filtering and sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable filtering",
      "info": "Filtering uses facets"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting"
    },
    {
      "type": "checkbox",
      "id": "collapse_on_larger_devices",
      "default": false,
      "label": "Collapse on larger devices"
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "Number of columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ]
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top spacing",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Brand Collection Grid"
    }
  ]
}
{% endschema %}
