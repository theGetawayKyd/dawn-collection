{{ 'section-collection-specific-menu.css' | asset_url | stylesheet_tag }}

<style>
  .collection-specific-menu-section {
    border-bottom: 1px solid rgba(var(--color-foreground), 0.08);
    padding: 0.5rem 0;
  }
  
  .collection-specific-menu__list {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }
  
  .collection-specific-menu__item {
    list-style: none;
  }
  
  .collection-specific-menu__link {
    display: block;
    padding: 0.5rem 0;
    text-decoration: none;
    color: rgba(var(--color-foreground), 0.75);
    transition: color 0.2s ease;
    font-size: 1rem;
  }
  
  .collection-specific-menu__link:hover,
  .collection-specific-menu__link--active {
    color: rgb(var(--color-foreground));
    text-decoration: underline;
  }
  
  @media screen and (max-width: 749px) {
    .collection-specific-menu__list {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>

<div class="collection-specific-menu-section color-{{ section.settings.color_scheme }} gradient page-width">
  {% if collection.metafields.custom.menu != blank %}
    <div class="collection-specific-menu">
      {% render 'collection-specific-menu', menu: collection.metafields.custom.menu %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Collection Menu",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 36,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 36,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Collection Menu"
    }
  ]
}
{% endschema %}
