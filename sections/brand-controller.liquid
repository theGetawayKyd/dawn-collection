{{ 'component-brand-controller.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign announcement_bar = false
  if section.blocks.size > 0 and section.settings.show_announcement
    assign announcement_bar = true
  endif
  
  # Determine active brand based on current page/collection
  assign active_brand_handle = ''
  
  # Check if we're on a page with a brand metafield
  if request.page_type == 'page' and page.metafields.brand.handle != blank
    assign active_brand_handle = page.metafields.brand.handle
  # Check if we're on a collection with a brand metafield
  elsif request.page_type == 'collection' and collection.metafields.brand.handle != blank
    assign active_brand_handle = collection.metafields.brand.handle
  # Check if we're on a product with a brand metafield
  elsif request.page_type == 'product' and product.metafields.brand.handle != blank
    assign active_brand_handle = product.metafields.brand.handle
  endif
  
  # Initialize active brand variables
  assign found_active_brand = false
  assign active_brand_menu_handle = ''
  assign active_brand_metaobject = nil
  
  
  # Get all brand metaobjects
  assign brands = metaobjects.brand
  assign all_brand_metaobjects = metaobjects.brand
  
  # Check if we have any brands
  assign has_brands = false
  if brands.size > 0
    assign has_brands = true
  endif
  
  # First check if any brand metaobject matches the active brand handle
  if active_brand_handle != blank
    for brand in brands
      if brand.brand_handle.value == active_brand_handle
        assign found_active_brand = true
        assign active_brand_metaobject = brand
        assign active_brand_menu_handle = brand.menu_handle.value
        break
      endif
    endfor
  endif
  
  # If no brand is explicitly marked as active, try to match by handle
  if found_active_brand == false and active_brand_handle != blank
    for block in section.blocks
      if block.type == 'brand' and block.settings.handle == active_brand_handle
        assign found_active_brand = true
        assign active_brand_menu_handle = block.settings.menu
        break
      endif
    endfor
  endif
  
  # Debug output for brand controller
  assign debug_brand_controller = true
  
  # Check if we have brands
  assign has_brands = false
  for block in section.blocks
    if block.type == 'brand'
      assign has_brands = true
      
      # If we have an active brand handle, check if this block matches
      if active_brand_handle != blank and block.settings.handle == active_brand_handle
        assign block.settings.is_active = true
        assign block.settings.menu = active_brand_menu_handle
      endif
    endif
  endfor
-%}

<div class="brand-controller{% if section.settings.show_line_separator %} brand-controller--border-bottom{% endif %}">

  <div class="page-width brand-controller__grid{% if announcement_bar %} brand-controller__grid--with-announcement{% endif %}">
    {%- if announcement_bar -%}
      <div
        class="brand-controller__announcement"
        role="region"
        aria-label="{{ 'sections.header.announcement' | t }}"
        {{ section.blocks.first.shopify_attributes }}
      >
        {%- if section.blocks.first.settings.text != blank -%}
          {%- if section.blocks.first.settings.link != blank -%}
            <a
              href="{{ section.blocks.first.settings.link }}"
              class="brand-controller__announcement-link link link--text focus-inset animate-arrow"
            >
          {%- endif -%}
          <p class="brand-controller__message h5">
            <span>{{ section.blocks.first.settings.text | escape }}</span>
            {%- if section.blocks.first.settings.link != blank -%}
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            {%- endif -%}
          </p>
          {%- if section.blocks.first.settings.link != blank -%}
            </a>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if has_brands -%}
      <div class="brand-controller__brands-container">
        <button type="button" class="brand-controller__dropdown-toggle">
          <span class="brand-controller__current-brand">
            {%- assign active_brand = false -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'brand' and block.settings.is_active -%}
                {%- assign active_brand = block -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            
            {%- if active_brand -%}
              {%- if active_brand.settings.image != blank -%}
                <img 
                  src="{{ active_brand.settings.image | image_url }}"
                  alt="{{ active_brand.settings.image.alt | escape }}"
                  loading="lazy"
                  class="brand-controller__current-brand-image"
                >
              {%- else -%}
                <span class="brand-controller__brand-text">{{ active_brand.settings.title | escape }}</span>
              {%- endif -%}
            {%- else -%}
              <span class="brand-controller__brand-text">{{ section.settings.dropdown_label | default: 'Our Brands' }}</span>
            {%- endif -%}
          </span>
          <span class="brand-controller__dropdown-icon">
            <svg viewBox="0 0 14 8" fill="none" aria-hidden="true" focusable="false" class="icon icon-caret" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M0 1.5L1.5 0L7 5.5L12.5 0L14 1.5L7 8.5L0 1.5Z" fill="currentColor"></path>
            </svg>
          </span>
        </button>

        <div class="brand-controller__brands-list">
          <ul class="brand-controller__brands">
            {%- for block in section.blocks -%}
              {%- if block.type == 'brand' -%}
                <li class="brand-controller__brand-item{% if block.settings.is_active %} brand-controller__brand-item--active{% endif %}">
                  <a 
                    href="{{ block.settings.link }}" 
                    class="brand-controller__brand-link{% if block.settings.is_active %} brand-controller__brand-link--active{% endif %}" 
                    data-brand-id="{{ block.id }}" 
                    data-brand-title="{{ block.settings.title | escape }}" 
                    data-brand-handle="{{ block.settings.handle }}"
                    data-brand-menu="{{ block.settings.menu }}"
                    data-prevent-navigation="{{ block.settings.prevent_navigation }}" 
                    {{ block.shopify_attributes }}
                  >
                    {%- if block.settings.image != blank -%}
                      <img 
                        src="{{ block.settings.image | image_url }}"
                        alt="{{ block.settings.image.alt | escape }}"
                        loading="lazy"
                      >
                    {%- else -%}
                      <span class="brand-controller__brand-text">{{ block.settings.title | escape }}</span>
                    {%- endif -%}
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Initialize brand controller functionality
    initBrandController();
  });

  function initBrandController() {
    const dropdownToggle = document.querySelector('.brand-controller__dropdown-toggle');
    const brandLinks = document.querySelectorAll('.brand-controller__brand-link');
    
    // Check if there's a stored active brand in session storage
    const storedActiveBrand = sessionStorage.getItem('activeBrand');
    
    // If we have a stored brand and it's not already active, activate it
    if (storedActiveBrand) {
      let brandFound = false;
      
      // Check if any of our current brands match the stored one
      brandLinks.forEach(link => {
        const brandId = link.getAttribute('data-brand-id');
        if (brandId === storedActiveBrand) {
          brandFound = true;
          // Only update if it's not already active
          if (!link.classList.contains('brand-controller__brand-link--active')) {
            // Remove active class from all links
            brandLinks.forEach(l => {
              l.classList.remove('brand-controller__brand-link--active');
              l.closest('.brand-controller__brand-item')?.classList.remove('brand-controller__brand-item--active');
            });
            
            // Add active class to this link
            link.classList.add('brand-controller__brand-link--active');
            link.closest('.brand-controller__brand-item')?.classList.add('brand-controller__brand-item--active');
            
            // Update dropdown toggle content if it exists
            updateDropdownToggle(link);
          }
        }
      });
      
      // If the stored brand isn't found in the current page, just keep the session storage
      // It might be used on other pages
    }
    
    // Add click event listeners to brand links
    brandLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        // Only prevent default if we're just switching brands without navigation
        if (this.getAttribute('data-prevent-navigation') === 'true') {
          e.preventDefault();
        }
        
        const brandId = this.getAttribute('data-brand-id');
        
        // Store the selected brand in session storage
        sessionStorage.setItem('activeBrand', brandId);
        
        // Broadcast the brand change event for other components to listen for
        const brandChangeEvent = new CustomEvent('brandChange', {
          detail: {
            brandId: brandId,
            brandTitle: this.getAttribute('data-brand-title'),
            brandUrl: this.getAttribute('href')
          }
        });
        document.dispatchEvent(brandChangeEvent);
        
        // Remove active class from all links
        brandLinks.forEach(link => {
          link.classList.remove('brand-controller__brand-link--active');
          link.closest('.brand-controller__brand-item')?.classList.remove('brand-controller__brand-item--active');
        });
        
        // Add active class to this link
        this.classList.add('brand-controller__brand-link--active');
        this.closest('.brand-controller__brand-item')?.classList.add('brand-controller__brand-item--active');
        
        // Update dropdown toggle
        updateDropdownToggle(this);
      });
    });
    
    // Dropdown toggle functionality for mobile
    if (dropdownToggle) {
      dropdownToggle.addEventListener('click', function() {
        const brandsList = document.querySelector('.brand-controller__brands-list');
        if (brandsList) {
          brandsList.classList.toggle('brand-controller__brands-list--open');
          dropdownToggle.classList.toggle('brand-controller__dropdown-toggle--open');
        }
      });

      // Close dropdown when clicking outside
      document.addEventListener('click', function(event) {
        const container = document.querySelector('.brand-controller__brands-container');
        if (container && !container.contains(event.target)) {
          const brandsList = document.querySelector('.brand-controller__brands-list');
          if (brandsList && brandsList.classList.contains('brand-controller__brands-list--open')) {
            brandsList.classList.remove('brand-controller__brands-list--open');
            dropdownToggle.classList.remove('brand-controller__dropdown-toggle--open');
          }
        }
      });
    }
  }
  
  // Helper function to update the dropdown toggle content
  function updateDropdownToggle(activeBrandLink) {
    const dropdownToggle = document.querySelector('.brand-controller__dropdown-toggle');
    if (!dropdownToggle) return;
    
    const currentBrandElement = dropdownToggle.querySelector('.brand-controller__current-brand');
    if (!currentBrandElement) return;
    
    // Clone the content from the active brand link
    const brandContent = activeBrandLink.cloneNode(true);
    
    // Clear the current content
    currentBrandElement.innerHTML = '';
    
    // If there's an image, use it
    const brandImage = brandContent.querySelector('img');
    if (brandImage) {
      brandImage.classList.add('brand-controller__current-brand-image');
      currentBrandElement.appendChild(brandImage);
    } else {
      // Otherwise use the text
      const brandText = brandContent.querySelector('.brand-controller__brand-text');
      if (brandText) {
        currentBrandElement.appendChild(brandText);
      }
    }
  }
</script>

{% schema %}
{
  "name": "Brand Controller",
  "class": "brand-controller-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "dropdown_label",
      "label": "Mobile dropdown label",
      "default": "Our Brands",
      "info": "Label shown on mobile when no brand is active"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "Show line separator"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Announce something here",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "default": "Brand name",
          "label": "Brand name",
          "info": "Used when no image is uploaded"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Brand handle",
          "info": "Unique identifier for this brand, used to match with page/collection metafields"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Brand logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Brand page URL",
          "info": "The page that this brand links to"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Brand menu",
          "info": "Menu to display when this brand is active"
        },
        {
          "type": "checkbox",
          "id": "prevent_navigation",
          "label": "Prevent navigation",
          "default": false,
          "info": "If checked, clicking this brand will only switch the active brand without navigating to the link"
        },
        {
          "type": "checkbox",
          "id": "is_active",
          "label": "Is active brand",
          "default": false,
          "info": "Highlights this brand as the active one"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Controller",
      "blocks": [
        {
          "type": "announcement"
        },
        {
          "type": "brand"
        },
        {
          "type": "brand"
        },
        {
          "type": "brand"
        }
      ]
    }
  ]
}
{% endschema %}
