{{ 'component-brand-controller.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign announcement_bar = false
  if section.blocks.size > 0 and section.settings.show_announcement
    assign announcement_bar = true
  endif
  
  # Determine active brand based on current page/collection
  assign active_brand_handle = ''
  
  # Check if we're on a page with a brand metafield
  if request.page_type == 'page' and page.metafields.brand.handle != blank
    assign active_brand_handle = page.metafields.brand.handle
  # Check if we're on a collection with a brand metafield
  elsif request.page_type == 'collection' and collection.metafields.brand.handle != blank
    assign active_brand_handle = collection.metafields.brand.handle
  # Check if we're on a product with a brand metafield
  elsif request.page_type == 'product' and product.metafields.brand.handle != blank
    assign active_brand_handle = product.metafields.brand.handle
  endif
  
  # Initialize active brand variables
  assign found_active_brand = false
  assign active_brand_menu_handle = ''
  assign active_brand_metaobject = nil
  
  
  # Get all brand metaobjects using the correct Shopify syntax
  # The metaobject definition exists, but we need to access the actual instances
  
  # In Shopify, metaobjects are accessed differently than other objects
  # We'll use a simpler approach that's more reliable
  
  # Get all brand metaobjects
  assign brands = metaobjects.brand
  
  # Store for reference
  assign all_brand_metaobjects = brands
  
  # Check if we have any brands
  assign has_brands = false
  if brands.size > 0
    assign has_brands = true
  endif
  
  # First check if any brand metaobject matches the active brand handle
  if active_brand_handle != blank
    for brand in brands
      if brand.brand_handle.value == active_brand_handle
        assign found_active_brand = true
        assign active_brand_metaobject = brand
        assign active_brand_menu_handle = brand.menu_handle.value
        break
      endif
    endfor
  endif
  
  # If no brand is explicitly marked as active, try to match by handle
  if found_active_brand == false and active_brand_handle != blank
    for block in section.blocks
      if block.type == 'brand' and block.settings.handle == active_brand_handle
        assign found_active_brand = true
        assign active_brand_menu_handle = block.settings.menu
        break
      endif
    endfor
  endif
  
  # Debug output for brand controller
  assign debug_brand_controller = true
  
  # Check if we have brands
  assign has_brands = false
  for block in section.blocks
    if block.type == 'brand'
      assign has_brands = true
      
      # If we have an active brand handle, check if this block matches
      if active_brand_handle != blank and block.settings.handle == active_brand_handle
        assign block.settings.is_active = true
        assign block.settings.menu = active_brand_menu_handle
      endif
    endif
  endfor
-%}

<div class="color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} border-bottom{% endif %}">

  <div class="page-width">
    <div class="grid grid--1-col grid--2-col-tablet grid--middle">
      <!-- Left side: Announcement -->
      {%- if announcement_bar -%}
        <div
          class="grid__item"
          role="region"
          aria-label="{{ 'sections.header.announcement' | t }}"
          {{ section.blocks.first.shopify_attributes }}
        >
          {%- if section.blocks.first.settings.text != blank -%}
            {%- if section.blocks.first.settings.link != blank -%}
              <a
                href="{{ section.blocks.first.settings.link }}"
                class="link link--text focus-inset animate-arrow"
              >
            {%- endif -%}
            <p class="h5 margin-bottom-0">
              <span>{{ section.blocks.first.settings.text | escape }}</span>
              {%- if section.blocks.first.settings.link != blank -%}
                {{- 'icon-arrow.svg' | inline_asset_content -}}
              {%- endif -%}
            </p>
            {%- if section.blocks.first.settings.link != blank -%}
              </a>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}
      
      <!-- Right side: Brand List -->
      {%- for block in section.blocks -%}
        {%- if block.type == 'brand_list' -%}
          <div class="grid__item text-right" {{ block.shopify_attributes }}>
            <ul class="list-unstyled inline-list">
              {%- comment -%}Use shop.metaobjects.brand.values based on Shopify Community solution{%- endcomment -%}
              {%- for brand in shop.metaobjects.brand.values -%}
                <li class="inline-list__item{% if brand.id == active_brand_metaobject.id %} active{% endif %}">
                  <a href="{% if brand.link.reference != blank %}{{ brand.link.reference.url }}{% else %}#{% endif %}" class="full-unstyled-link">
                    {%- if brand.image != blank -%}
                      <img 
                        src="{{ brand.image | image_url: width: block.settings.logo_width }}"
                        alt="{{ brand.title | escape }}"
                        loading="lazy"
                        width="{{ block.settings.logo_width }}"
                        height="{{ brand.image.height | divided_by: brand.image.width | times: block.settings.logo_width | round }}"
                        class="brand-logo"
                      >
                    {%- else -%}
                      <div class="brand-placeholder" style="width: {{ block.settings.logo_width }}px; height: 20px;">
                        {{ brand.title | escape | first | upcase }}
                      </div>
                    {%- endif -%}
                    
                    {%- if block.settings.show_titles -%}
                      <span class="brand-title">{{ brand.title }}</span>
                    {%- endif -%}
                  </a>
                </li>
              {%- else -%}
                {%- comment -%}No brands found, show a message in the theme editor{%- endcomment -%}
                {%- if request.design_mode -%}
                  <li class="inline-list__item">
                    <div class="full-unstyled-link">
                      <div style="padding: 10px; background-color: #f4f4f4; border-radius: 4px; text-align: center;">
                        <p>No brand metaobjects found. Create brand metaobjects to display them here.</p>
                      </div>
                    </div>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}

    </div> <!-- End of grid -->
    
    {%- if has_brands -%}
      <div class="mobile-facets__wrapper medium-hide small-hide">
        <details class="mobile-facets">
          <summary class="mobile-facets__summary">
            <div class="mobile-facets__summary-inner">
              {%- assign active_brand = false -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'brand' and block.settings.is_active -%}
                  {%- assign active_brand = block -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
              
              {%- if active_brand -%}
                {%- if active_brand.settings.image != blank -%}
                  <img 
                    src="{{ active_brand.settings.image | image_url }}"
                    alt="{{ active_brand.settings.image.alt | escape }}"
                    loading="lazy"
                    class="brand-logo"
                  >
                {%- else -%}
                  <span>{{ active_brand.settings.title | escape }}</span>
                {%- endif -%}
              {%- else -%}
                <span>{{ section.settings.dropdown_label | default: 'Our Brands' }}</span>
              {%- endif -%}
              
              <span class="mobile-facets__arrow-icon">
                <svg viewBox="0 0 14 8" fill="none" aria-hidden="true" focusable="false" class="icon icon-caret" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M0 1.5L1.5 0L7 5.5L12.5 0L14 1.5L7 8.5L0 1.5Z" fill="currentColor"></path>
                </svg>
              </span>
            </div>
          </summary>
          
          <div class="mobile-facets__body">
            <ul class="mobile-facets__list list-unstyled">
              {%- for block in section.blocks -%}
                {%- if block.type == 'brand' -%}
                  <li class="mobile-facets__item{% if block.settings.is_active %} mobile-facets__item--active{% endif %}">
                    <a 
                      href="{{ block.settings.link }}" 
                      class="mobile-facets__link{% if block.settings.is_active %} mobile-facets__link--active{% endif %}" 
                      data-brand-id="{{ block.id }}" 
                      data-brand-title="{{ block.settings.title | escape }}" 
                      data-brand-handle="{{ block.settings.handle }}"
                      data-brand-menu="{{ block.settings.menu }}"
                      data-prevent-navigation="{{ block.settings.prevent_navigation }}" 
                      {{ block.shopify_attributes }}
                    >
                      {%- if block.settings.image != blank -%}
                        <img 
                          src="{{ block.settings.image | image_url }}"
                          alt="{{ block.settings.image.alt | escape }}"
                          loading="lazy"
                          class="brand-logo"
                        >
                      {%- else -%}
                        <span>{{ block.settings.title | escape }}</span>
                      {%- endif -%}
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        </details>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Initialize brand controller functionality
    initBrandController();
  });

  function initBrandController() {
    const mobileDetails = document.querySelector('.mobile-facets');
    const brandLinks = document.querySelectorAll('.mobile-facets__link');
    const desktopBrandLinks = document.querySelectorAll('.full-unstyled-link');
    
    // Check if there's a stored active brand in session storage
    const storedActiveBrand = sessionStorage.getItem('activeBrand');
    
    // If we have a stored brand and it's not already active, activate it
    if (storedActiveBrand) {
      let brandFound = false;
      
      // Check if any of our current brands match the stored one
      brandLinks.forEach(link => {
        const brandId = link.getAttribute('data-brand-id');
        
        if (brandId === storedActiveBrand) {
          brandFound = true;
          
          // Only activate if it's not already active
          if (!link.classList.contains('mobile-facets__link--active')) {
            // Deactivate all other brands
            brandLinks.forEach(otherLink => {
              otherLink.classList.remove('mobile-facets__link--active');
              otherLink.closest('.mobile-facets__item')?.classList.remove('mobile-facets__item--active');
            });
            
            // Activate this brand
            link.classList.add('mobile-facets__link--active');
            link.closest('.mobile-facets__item')?.classList.add('mobile-facets__item--active');
          }
        }
      });
    }
    
    // Add click event listeners to mobile brand links
    brandLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        // Only prevent default if we're just switching brands without navigation
        if (this.getAttribute('data-prevent-navigation') === 'true') {
          e.preventDefault();
        }
        
        // Store the active brand in session storage
        const brandId = this.getAttribute('data-brand-id');
        sessionStorage.setItem('activeBrand', brandId);
        
        // Deactivate all other brands
        brandLinks.forEach(otherLink => {
          otherLink.classList.remove('mobile-facets__link--active');
          otherLink.closest('.mobile-facets__item')?.classList.remove('mobile-facets__item--active');
        });
        
        // Activate this brand
        this.classList.add('mobile-facets__link--active');
        this.closest('.mobile-facets__item')?.classList.add('mobile-facets__item--active');
        
        // Close the details element
        if (mobileDetails) {
          mobileDetails.removeAttribute('open');
        }
      });
    });
    
    // Add click event listeners to desktop brand links
    desktopBrandLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        // Only prevent default if we're just switching brands without navigation
        if (this.getAttribute('data-prevent-navigation') === 'true') {
          e.preventDefault();
        }
        
        // Deactivate all other brands
        desktopBrandLinks.forEach(otherLink => {
          otherLink.closest('.inline-list__item')?.classList.remove('active');
        });
        
        // Activate this brand
        this.closest('.inline-list__item')?.classList.add('active');
      });
    });
  }
</script>

{% schema %}
{
  "name": "Brand Controller",
  "class": "brand-controller-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "dropdown_label",
      "label": "Mobile dropdown label",
      "default": "Our Brands",
      "info": "Label shown on mobile when no brand is active"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "Show line separator"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Announce something here",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "brand_list",
      "name": "Brand List",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "This block automatically displays all brand metaobjects in a horizontal list."
        },
        {
          "type": "checkbox",
          "id": "show_titles",
          "label": "Show brand titles",
          "default": false,
          "info": "Display brand names below the logos"
        },
        {
          "type": "range",
          "id": "logo_width",
          "min": 50,
          "max": 200,
          "step": 10,
          "unit": "px",
          "label": "Logo width",
          "default": 120
        },
        {
          "type": "checkbox",
          "id": "use_carousel",
          "label": "Use carousel for mobile",
          "default": true,
          "info": "Enables horizontal scrolling on mobile devices"
        }
      ]
    },
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "default": "Brand name",
          "label": "Brand name",
          "info": "Used when no image is uploaded"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Brand handle",
          "info": "Unique identifier for this brand, used to match with page/collection metafields"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Brand logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Brand page URL",
          "info": "The page that this brand links to"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Brand menu",
          "info": "Menu to display when this brand is active"
        },
        {
          "type": "checkbox",
          "id": "prevent_navigation",
          "label": "Prevent navigation",
          "default": false,
          "info": "If checked, clicking this brand will only switch the active brand without navigating to the link"
        },
        {
          "type": "checkbox",
          "id": "is_active",
          "label": "Is active brand",
          "default": false,
          "info": "Highlights this brand as the active one"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Controller",
      "blocks": [
        {
          "type": "announcement"
        },
        {
          "type": "brand_list"
        }
      ]
    }
  ]
}
{% endschema %}
