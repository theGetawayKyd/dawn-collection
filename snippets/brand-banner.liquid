{% comment %}
  Brand Banner Snippet
  
  This snippet displays a horizontal list of brand logos and allows customers to navigate to brand pages.
  It uses metaobjects to retrieve brand information.
  
  Note: Brand detection is now handled in brand-detection.liquid
{% endcomment %}


{% assign debug_info = '' %}
{% assign banner_height = banner_height | default: 40 %}
{% assign logo_padding = logo_padding | default: 5 %}
{% assign text_color = text_color | default: '#000000' %}
{% assign background_color = background_color | default: '#f8f8f8' %}
{% assign logo_alignment = logo_alignment | default: 'right' %}
{% assign active_brand_bg_color = active_brand_bg_color | default: '#f0f0f0' %}
{% assign announcement_text = announcement_text | default: 'Free shipping on all orders!' %}

<style>
  .brand-banner {
    height: {{ banner_height }}px;
    display: flex;
    align-items: center;
  }
  
  /* No longer hiding the entire brand banner on mobile */
  
  .brand-banner__container {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  .brand-banner__announcement {
    flex: 0 0 auto;
    padding: 0 20px 0 0;
    font-weight: 500;
    font-size: 0.9em;
    color: {{ text_color }};
    white-space: nowrap;
  }
  
  /* Make announcement bar full width on mobile and tablet */
  @media screen and (max-width: 989px) {
    .brand-banner__announcement {
      flex: 1 1 100%;
      text-align: center;
      padding: 0;
    }
    
    .brand-banner__container {
      justify-content: center;
    }
    
    .brand-banner__list-container {
      display: none;
    }
  }
  
  .brand-banner__list-container {
    flex: 0 1 auto;
    overflow-x: auto;
  }
  
  .brand-banner__list {
    display: flex;
    flex-wrap: nowrap;
    list-style: none;
    margin: 0;
    padding: 0;
    height: 100%;
    align-items: center;
    {% if logo_alignment == 'left' %}
    justify-content: flex-start;
    {% elsif logo_alignment == 'center' %}
    justify-content: center;
    {% else %}
    justify-content: flex-end;
    {% endif %}
  }
  
  .brand-banner__item {
    flex: 0 0 auto;
    padding: {{ logo_padding }}px;
  }
  
  .brand-banner__link {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    height: 100%;
    transition: transform 0.2s ease;
  }
  
  .brand-banner__link:hover {
    /* Hover effect removed as requested */
  }
  
  .brand-banner__item--active {
    background-color: {{ active_brand_bg_color }};
    color: #ffffff;
  }
  
  .brand-banner__item--active .brand-banner__link {
    border-bottom: 2px solid var(--color-primary);
  }
  
  /* Mobile styles removed */
  
  /* Dropdown drawer that descends from header */
  .brand-banner__drawer {
    position: absolute;
    top: 0; /* Will be set dynamically by JavaScript */
    left: 0;
    width: 100%;
    z-index: 1000;
    visibility: hidden;
    opacity: 0;
    transform: translateY(-20px);
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0s linear 0.3s;
  }
  
  .brand-banner__drawer.active {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0s linear 0s;
  }
  
  .brand-banner__drawer-overlay {
    position: fixed;
    width: 100%;
    height: 100vh;
    top: 0;
    left: 0;
    background: rgba(var(--color-foreground), 0.5);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0s linear 0.3s;
    z-index: 999;
  }
  
  .brand-banner__drawer.active .brand-banner__drawer-overlay {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.3s ease, visibility 0s linear 0s;
  }
  
  .brand-banner__drawer-inner {
    position: relative;
    background-color: rgb(var(--color-background));
    box-shadow: 0 4px 6px rgba(var(--color-foreground), 0.1);
    max-height: 80vh;
    overflow-y: auto;
  }
  
  .brand-banner__drawer-close {
    display: none; /* Hide the close button */
  }
  
  .brand-banner__drawer-content {
    padding: 1.5rem;
  }
  
  .brand-banner__drawer-logos-container {
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE and Edge */
  }
  
  .brand-banner__drawer-logos-container::-webkit-scrollbar {
    display: none; /* Chrome, Safari, Opera */
  }
  
  .brand-banner__drawer-logos {
    display: flex;
    flex-wrap: nowrap;
    list-style: none;
    margin: 0 auto;
    padding: 0;
    gap: 1.5rem;
    justify-content: center;
  }
  
  .brand-banner__drawer-logo-item {
    flex: 0 0 auto;
    text-align: center;
  }
  
  .brand-banner__drawer-logo-item--active {
    position: relative;
  }
  
  .brand-banner__drawer-logo-item--active::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 50%;
    transform: translateX(-50%);
    width: 80%;
    height: 2px;
    background-color: var(--color-primary);
  }
  
  .brand-banner__drawer-logo-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: rgb(var(--color-foreground));
  }
  
  .brand-banner__drawer-logo {
    max-width: 100px;
    width: auto;
    object-fit: contain;
  }
  
  .brand-banner__drawer-name {
    font-size: 0.8rem;
    margin-top: 0.25rem;
    display: none;
    }
  }
  
  .brand-banner__logo {
    height: calc({{ banner_height }}px - {{ logo_padding | times: 2 }}px);
  }
  
  .brand-banner__name {
    font-weight: 600;
    color: {{ text_color }};
  }
</style>

<div class="brand-banner" style="background-color: {{ background_color }};">
  <div class="brand-banner__container page-width">
    <div class="brand-banner__announcement">
      {{ announcement_text }}
    </div>
    
    <div class="brand-banner__list-container">
      <ul class="brand-banner__list">
      {% comment %} Access brand metaobjects using shop.metaobjects.brand.values {% endcomment %}
      {% comment %} Sort brands by sort_order if available, otherwise use title {% endcomment %}
      {% assign has_sort_order = false %}
      {% for brand in shop.metaobjects.brand.values %}
        {% if brand.sort_order != blank %}
          {% assign has_sort_order = true %}
          {% break %}
        {% endif %}
      {% endfor %}
      
      {% if has_sort_order %}
        {% assign sorted_brands = shop.metaobjects.brand.values | sort: 'sort_order' %}
      {% else %}
        {% assign sorted_brands = shop.metaobjects.brand.values | sort: 'title' %}
      {% endif %}
      
      {% for brand in sorted_brands %} 
        

           
        {% if brand.brand_handle != blank %}
          {% assign brand_handle = brand.brand_handle %}
          {% assign brand_title = brand.title %}
          {% assign brand_logo = brand.logo %}
          
          {% comment %} Try different approaches to get the URL {% endcomment %}
          {% if brand.link.value.url != blank %}
            {% assign brand_link = brand.link.value.url %}
          {% elsif brand.link.url != blank %}
            {% assign brand_link = brand.link.url %}
          {% elsif brand.link.value != blank %}
            {% assign brand_link = brand.link.value %}
          {% else %}
            {% assign brand_link = brand.link %}
          {% endif %}
          


          <li class="brand-banner__item{% if selected_brand == brand_handle %} brand-banner__item--active{% endif %}">
            <a href="{{ brand_link }}" class="brand-banner__link" data-brand-handle="{{ brand_handle }}" aria-label="Visit {{ brand_title }} brand page">
              {% comment %} Determine which logo to display based on active state and default_logo_shade setting {% endcomment %}
              {% if selected_brand == brand_handle %}
                {% assign is_active = true %}
              {% else %}
                {% assign is_active = false %}
              {% endif %}
              {% assign use_light_logo = false %}
              
              {% comment %} Determine which logo shade to use based on settings {% endcomment %}
              {% if default_logo_shade == 'light' %}
                {% if is_active and use_opposite_shade_for_active %}
                  {% comment %} Active brand uses opposite of default shade if enabled {% endcomment %}
                  {% assign use_light_logo = false %}
                {% else %}
                  {% assign use_light_logo = true %}
                {% endif %}
              {% else %}
                {% if is_active and use_opposite_shade_for_active %}
                  {% comment %} Active brand uses opposite of default shade if enabled {% endcomment %}
                  {% assign use_light_logo = true %}
                {% else %}
                  {% assign use_light_logo = false %}
                {% endif %}
              {% endif %}
              
              {% if use_light_logo %}
                {% if brand.monochrome_logo_light != blank %}
                  {% assign logo_to_display = brand.monochrome_logo_light %}
                {% else %}
                  {% assign logo_to_display = brand_logo %}
                {% endif %}
              {% else %}
                {% if brand.monochrome_logo_dark != blank %}
                  {% assign logo_to_display = brand.monochrome_logo_dark %}
                {% else %}
                  {% assign logo_to_display = brand_logo %}
                {% endif %}
              {% endif %}
              
              {% if logo_to_display != blank %}
                {% assign logo_height = banner_height | minus: logo_padding | minus: logo_padding %}
                {{ logo_to_display | image_url: height: logo_height | image_tag: 
                  alt: brand_title,
                  class: 'brand-banner__logo',
                  loading: 'lazy'
                }}
              {% else %}
                <span class="brand-banner__name">{{ brand_title }}</span>
              {% endif %}
            </a>
          </li>
        {% endif %}
      {% endfor %}
      </ul>
    </div>
  </div>
</div>

{% comment %} Brand Drawer for Mobile View {% endcomment %}
<div id="BrandDrawer" class="brand-banner__drawer">
  <div class="brand-banner__drawer-overlay"></div>
  <div class="brand-banner__drawer-inner">
    <div class="brand-banner__drawer-content">
      <div class="brand-banner__drawer-logos-container">
        <ul class="brand-banner__drawer-logos">
          {% for brand in sorted_brands %}
            {% if brand.brand_handle != blank %}
              {% assign brand_handle = brand.brand_handle %}
              {% assign brand_title = brand.title %}
              {% assign brand_logo = brand.logo %}
              
              {% comment %} Try different approaches to get the URL {% endcomment %}
              {% if brand.link.value.url != blank %}
                {% assign brand_link = brand.link.value.url %}
              {% elsif brand.link.url != blank %}
                {% assign brand_link = brand.link.url %}
              {% elsif brand.link.value != blank %}
                {% assign brand_link = brand.link.value %}
              {% else %}
                {% assign brand_link = brand.link %}
              {% endif %}
              
              {% comment %} Determine if this is the active brand {% endcomment %}
              {% if selected_brand == brand_handle %}
                {% assign is_active = true %}
              {% else %}
                {% assign is_active = false %}
              {% endif %}
              
              {% comment %} Determine which logo shade to use based on settings {% endcomment %}
              {% assign use_light_logo = false %}
              {% if default_logo_shade == 'light' %}
                {% if is_active and use_opposite_shade_for_active %}
                  {% comment %} Active brand uses opposite of default shade if enabled {% endcomment %}
                  {% assign use_light_logo = false %}
                {% else %}
                  {% assign use_light_logo = true %}
                {% endif %}
              {% else %}
                {% if is_active and use_opposite_shade_for_active %}
                  {% comment %} Active brand uses opposite of default shade if enabled {% endcomment %}
                  {% assign use_light_logo = true %}
                {% else %}
                  {% assign use_light_logo = false %}
                {% endif %}
              {% endif %}
              
              {% comment %} Select the appropriate logo based on shade settings {% endcomment %}
              {% if use_light_logo %}
                {% if brand.monochrome_logo_light != blank %}
                  {% assign logo_to_display = brand.monochrome_logo_light %}
                {% else %}
                  {% assign logo_to_display = brand_logo %}
                {% endif %}
              {% else %}
                {% if brand.monochrome_logo_dark != blank %}
                  {% assign logo_to_display = brand.monochrome_logo_dark %}
                {% else %}
                  {% assign logo_to_display = brand_logo %}
                {% endif %}
              {% endif %}
              
              <li class="brand-banner__drawer-logo-item{% if is_active %} brand-banner__drawer-logo-item--active{% endif %}">
                <a href="{{ brand_link }}" class="brand-banner__drawer-logo-link" data-brand-handle="{{ brand_handle }}" aria-label="Visit {{ brand_title }} brand page">
                  {% if logo_to_display != blank %}
                    {% assign logo_height = banner_height | minus: logo_padding | minus: logo_padding %}
                    {{ logo_to_display | image_url: height: logo_height | image_tag: 
                      alt: brand_title,
                      class: 'brand-banner__drawer-logo',
                      loading: 'lazy'
                    }}
                  {% else %}
                    <span class="brand-banner__drawer-name">{{ brand_title }}</span>
                  {% endif %}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</div>

{% comment %} JavaScript for brand drawer functionality {% endcomment %}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Get drawer elements
    const brandDrawer = document.getElementById('BrandDrawer');
    const brandDrawerOverlay = document.querySelector('.brand-banner__drawer-overlay');
    
    // Find the header logo link to use as the toggle
    const headerLogoLink = document.querySelector('.header__heading-link');
    const header = document.querySelector('header');
    
    // Function to position the drawer below the header
    function positionDrawer() {
      // Move the drawer to be a child of the body element for proper positioning
      if (brandDrawer.parentElement !== document.body) {
        document.body.appendChild(brandDrawer);
      }
      
      // Position the drawer below the header
      const headerRect = header.getBoundingClientRect();
      const headerBottom = headerRect.bottom + window.scrollY;
      brandDrawer.style.top = headerBottom + 'px';
    }
    
    // Call positionDrawer on page load and window resize
    positionDrawer();
    window.addEventListener('resize', positionDrawer);
    window.addEventListener('scroll', positionDrawer);
    
    // Function to open the drawer
    function openDrawer() {
      positionDrawer(); // Ensure correct positioning before opening
      brandDrawer.classList.add('active');
      brandDrawerOverlay.style.opacity = '1';
      brandDrawerOverlay.style.visibility = 'visible';
      if (headerLogoLink) {
        headerLogoLink.setAttribute('aria-expanded', 'true');
      }
    }
    
    // Function to close the drawer
    function closeDrawer() {
      brandDrawer.classList.remove('active');
      brandDrawerOverlay.style.opacity = '0';
      brandDrawerOverlay.style.visibility = 'hidden';
      if (headerLogoLink) {
        headerLogoLink.setAttribute('aria-expanded', 'false');
      }
    }
    
    // Check if we're on mobile or tablet
    function isMobileOrTablet() {
      return window.innerWidth <= 989;
    }
    
    // Handle logo click based on screen size
    if (headerLogoLink) {
      headerLogoLink.addEventListener('click', function(event) {
        if (isMobileOrTablet()) {
          event.preventDefault();
          if (brandDrawer.classList.contains('active')) {
            closeDrawer();
          } else {
            openDrawer();
          }
        }
      });
      
      // Set cursor style based on screen size
      if (isMobileOrTablet()) {
        headerLogoLink.style.cursor = 'pointer';
      }
      
      // Update cursor style on window resize
      window.addEventListener('resize', function() {
        if (isMobileOrTablet()) {
          headerLogoLink.style.cursor = 'pointer';
        } else {
          headerLogoLink.style.cursor = '';
        }
      });
    }
    
    // Close drawer when clicking on overlay
    brandDrawerOverlay.addEventListener('click', closeDrawer);
    
    // Close drawer when pressing Escape key
    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape' && brandDrawer.classList.contains('active')) {
        closeDrawer();
      }
    });
  });
</script>



