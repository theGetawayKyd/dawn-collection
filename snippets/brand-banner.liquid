{% comment %}
  Brand Banner Snippet
  
  This snippet displays a horizontal list of brand logos and allows customers to navigate to brand pages.
  It uses metaobjects to retrieve brand information.
{% endcomment %}

{% comment %}
  Brand detection logic - detect the brand based on the current URL
  This sets the selected_brand variable which is used to highlight the active brand
{% endcomment %}

{% assign current_url = request.path %}
{% assign current_page_type = request.page_type %}
{% assign detected_brand = '' %}

{% comment %} First check if we already have a selected brand in cart attributes {% endcomment %}
{% assign selected_brand = cart.attributes.selected_brand | default: '' %}

{% comment %} If no brand is selected in cart attributes, try to detect it from the URL {% endcomment %}
{% assign debug_info = '' %}
{% assign banner_height = banner_height | default: 40 %}
{% assign logo_padding = logo_padding | default: 5 %}
{% assign text_color = text_color | default: '#000000' %}
{% assign background_color = background_color | default: '#f8f8f8' %}
{% assign logo_alignment = logo_alignment | default: 'right' %}
{% assign active_brand_bg_color = active_brand_bg_color | default: '#f0f0f0' %}

<style>
  .brand-banner {
    height: {{ banner_height }}px;
    display: flex;
    align-items: center;
  }
  
  .brand-banner__container {
    width: 100%;
  }
  
  .brand-banner__list {
    display: flex;
    flex-wrap: nowrap;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    height: 100%;
    align-items: center;
    {% if logo_alignment == 'left' %}
    justify-content: flex-start;
    {% elsif logo_alignment == 'center' %}
    justify-content: center;
    {% else %}
    justify-content: flex-end;
    {% endif %}
  }
  
  .brand-banner__item {
    flex: 0 0 auto;
    padding: {{ logo_padding }}px;
  }
  
  
  .brand-banner__link {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    height: 100%;
    transition: transform 0.2s ease;
  }
  
  .brand-banner__link:hover {
    /* Hover effect removed as requested */
  }
  
  .brand-banner__item--active {
    background-color: {{ active_brand_bg_color }};
  }
  
  .brand-banner__item--active .brand-banner__link {
    border-bottom: 2px solid var(--color-primary);
  }
  
  .brand-banner__logo {
    height: calc({{ banner_height }}px - {{ logo_padding | times: 2 }}px);
  }
  
  .brand-banner__name {
    font-weight: 600;
    color: {{ text_color }};
  }
</style>

<div class="brand-banner" style="background-color: {{ background_color }};">
  <div class="brand-banner__container page-width">
    <ul class="brand-banner__list">
      {% comment %} Access brand metaobjects using shop.metaobjects.brand.values {% endcomment %}
      {% comment %} Sort brands by sort_order if available, otherwise use title {% endcomment %}
      {% assign has_sort_order = false %}
      {% for brand in shop.metaobjects.brand.values %}
        {% if brand.sort_order != blank %}
          {% assign has_sort_order = true %}
          {% break %}
        {% endif %}
      {% endfor %}
      
      {% if has_sort_order %}
        {% assign sorted_brands = shop.metaobjects.brand.values | sort: 'sort_order' %}
      {% else %}
        {% assign sorted_brands = shop.metaobjects.brand.values | sort: 'title' %}
      {% endif %}
      
      {% for brand in sorted_brands %}      
        {% if brand.brand_handle != blank %}
          {% assign brand_handle = brand.brand_handle %}
          {% assign brand_title = brand.title %}
          {% assign brand_logo = brand.logo %}
          
          {% comment %} Try different approaches to get the URL {% endcomment %}
          {% if brand.link.value.url != blank %}
            {% assign brand_link = brand.link.value.url %}
          {% elsif brand.link.url != blank %}
            {% assign brand_link = brand.link.url %}
          {% elsif brand.link.value != blank %}
            {% assign brand_link = brand.link.value %}
          {% else %}
            {% assign brand_link = brand.link %}
          {% endif %}

                   
          {% comment %} Detect if this brand matches the current collection {% endcomment %}
          {% if detected_brand == blank and current_page_type == 'collection' %}
            {% comment %} Compare brand_handle directly with collection.handle {% endcomment %}
            {% if collection.handle == brand_handle %}
              {% assign detected_brand = brand_handle %}
            {% endif %}
          {% endif %}

          {{ brand_handle }} - {{ detected_brand }}
          
          <li class="brand-banner__item{% if selected_brand == brand_handle %} brand-banner__item--active{% endif %}">
            <a href="{{ brand_link }}" class="brand-banner__link" aria-label="Visit {{ brand_title }} brand page">
              {% if brand_logo != blank %}
                {% assign logo_height = banner_height | minus: logo_padding | minus: logo_padding %}
                {{ brand_logo | image_url: height: logo_height | image_tag: 
                  alt: brand_title,
                  class: 'brand-banner__logo',
                  loading: 'lazy'
                }}
              {% else %}
                <span class="brand-banner__name">{{ brand_title }}</span>
              {% endif %}
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</div>

{% comment %} Set selected_brand from detected_brand if no brand is selected in cart attributes {% endcomment %}
{% if selected_brand == blank and detected_brand != blank %}
  {% assign selected_brand = detected_brand %}
{% endif %}

{% comment %} Debug information {% endcomment %}
{% if show_debug %}
  <div style="background-color: #f8f8f8; padding: 10px; font-size: 12px; color: #333; text-align: left;">
    <strong>Brand Banner Debug:</strong><br>
    Metaobject Count: {{ shop.metaobjects.brand.values.size }}<br>
    Selected Brand: "{{ selected_brand | default: 'None' }}"<br>
    Detected Brand: "{{ detected_brand | default: 'None' }}"<br>
    Current URL: "{{ current_url }}"<br>
    Current Page Type: "{{ current_page_type }}"<br>
    Cart Attribute: "{{ cart.attributes.selected_brand | default: 'None' }}"
  </div>
{% endif %}
{% if show_debug %}
  <div class="brand-banner__debug" style="background-color: #f8f8f8; padding: 15px; margin-top: 20px; border: 1px solid #ddd;">
    <h3>Brand Banner Debug Info</h3>
    <p>Selected Brand: {{ selected_brand | default: 'None' }}</p>
    <p>Debug enabled: {{ show_debug }}</p>
    <p>Total brands found: {{ shop.metaobjects.brand.values.size }}</p>
    
    {% assign first_brand = shop.metaobjects.brand.values | first %}
    {% if first_brand %}
      <h4>First Brand Link Structure:</h4>
      <ul>
        <li>brand.link: {{ first_brand.link }}</li>
        <li>brand.link.type: {{ first_brand.link.type }}</li>
        <li>brand.link.value: {{ first_brand.link.value }}</li>
        <li>brand.link.value.url: {{ first_brand.link.value.url }}</li>
      </ul>
    {% endif %}
    
    <h4>Raw brand data:</h4>
    <div style="background-color: white; padding: 10px; border: 1px solid #ccc; overflow: auto; max-height: 300px;">
      {% for brand in shop.metaobjects.brand.values %}
        <div style="margin-bottom: 15px; padding-bottom: 15px; border-bottom: 1px solid #eee;">
          <p><strong>Brand #{{ forloop.index }}</strong></p>
          <p>Handle: {{ brand.brand_handle }}</p>
          <p>Title: {{ brand.title }}</p>
          <p>Sort Order: {{ brand.sort_order | default: 'Not set' }}</p>
          <p>Link: {{ brand.link.value.url }}</p>
        </div>
      {% else %}
        <p><strong>No brands found in shop.metaobjects.brand.values</strong></p>
      {% endfor %}
    </div>
    </div>
  </div>
{% endif %}

<style>
  .brand-banner__debug {
    margin-top: 10px;
    padding: 10px;
    background-color: #f8f9fa;
    border: 1px solid #dee2e6;
    border-radius: 4px;
  }
</style>
