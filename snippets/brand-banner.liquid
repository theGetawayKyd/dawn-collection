{% comment %}
  Brand Banner Snippet
  
  This snippet displays a horizontal list of brand logos and allows customers to navigate to brand pages.
  It uses metaobjects to retrieve brand information.
{% endcomment %}

{% assign selected_brand = cart.attributes.selected_brand | default: '' %}

<div class="brand-banner">
  <div class="brand-banner__container page-width">
    <ul class="brand-banner__list">
      {% comment %} Access brand metaobjects using shop.metaobjects.brand.values {% endcomment %}
      {% for brand in shop.metaobjects.brand.values %}
        {% if brand.brand_handle != blank %}
          {% assign brand_handle = brand.brand_handle %}
          {% assign brand_title = brand.title %}
          {% assign brand_logo = brand.logo %}
          {% assign brand_link = brand.link %}
          
          <li class="brand-banner__item{% if selected_brand == brand_handle %} brand-banner__item--active{% endif %}">
            <a href="{{ brand_link }}" class="brand-banner__link" aria-label="Visit {{ brand_title }} brand page">
              {% if brand_logo != blank %}
                <img 
                  src="{{ brand_logo | image_url: width: 100 }}" 
                  alt="{{ brand_title }}" 
                  width="100" 
                  height="{{ 100 | divided_by: brand_logo.aspect_ratio | round }}" 
                  loading="lazy"
                  class="brand-banner__logo"
                >
              {% else %}
                <span class="brand-banner__name">{{ brand_title }}</span>
              {% endif %}
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</div>

{% comment %} Debug information for metaobject access issues {% endcomment %}
{% if show_debug %}
  <div class="brand-banner__debug">
    <details>
      <summary>Debug Info</summary>
      <div class="brand-banner__debug-content">
        <p>Selected Brand: {{ selected_brand | default: 'None' }}</p>
        <p>Available Brands:</p>
        <ul>
          {% for brand in shop.metaobjects.brand.values %}
            <li>
              {{ brand.title }} ({{ brand.brand_handle }})
              {% if brand.link != blank %}
                - Link: {{ brand.link }}
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </div>
    </details>
  </div>
{% endif %}

<style>
  .brand-banner {
    background-color: var(--color-background);
    border-bottom: 1px solid var(--color-border);
    padding: 10px 0;
  }
  
  .brand-banner__list {
    display: flex;
    flex-wrap: nowrap;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    gap: 20px;
    justify-content: center;
  }
  
  .brand-banner__item {
    flex: 0 0 auto;
  }
  
  .brand-banner__link {
    display: block;
    text-decoration: none;
    padding: 5px;
    transition: transform 0.2s ease;
  }
  
  .brand-banner__link:hover {
    transform: scale(1.05);
  }
  
  .brand-banner__item--active .brand-banner__link {
    border-bottom: 2px solid var(--color-primary);
  }
  
  .brand-banner__logo {
    max-height: 50px;
    width: auto;
    object-fit: contain;
  }
  
  .brand-banner__name {
    font-weight: 600;
    color: var(--color-text);
  }
  
  .brand-banner__debug {
    margin-top: 10px;
    padding: 10px;
    background-color: #f8f9fa;
    border: 1px solid #dee2e6;
    border-radius: 4px;
  }
</style>
