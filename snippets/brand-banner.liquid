{% comment %}
  Brand Banner Snippet
  
  This snippet displays a horizontal list of brand logos and allows customers to navigate to brand pages.
  It uses metaobjects to retrieve brand information.
  
  Note: Brand detection is now handled in brand-detection.liquid
{% endcomment %}


{% assign debug_info = '' %}
{% assign banner_height = banner_height | default: 40 %}
{% assign logo_padding = logo_padding | default: 5 %}
{% assign text_color = text_color | default: '#000000' %}
{% assign background_color = background_color | default: '#f8f8f8' %}
{% assign logo_alignment = logo_alignment | default: 'right' %}
{% assign active_brand_bg_color = active_brand_bg_color | default: '#f0f0f0' %}
{% assign announcement_text = announcement_text | default: 'Free shipping on all orders!' %}

<style>
  .brand-banner {
    height: {{ banner_height }}px;
    display: flex;
    align-items: center;
  }
  
  @media screen and (max-width: 749px) {
    .brand-banner {
      display: none; /* Hide the brand banner only on mobile */
    }
  }
  
  .brand-banner__container {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  .brand-banner__announcement {
    flex: 0 0 auto;
    padding: 0 20px 0 0;
    font-weight: 500;
    font-size: 0.9em;
    color: {{ text_color }};
    white-space: nowrap;
  }
  
  .brand-banner__list-container {
    flex: 0 1 auto;
    overflow-x: auto;
  }
  
  .brand-banner__list {
    display: flex;
    flex-wrap: nowrap;
    list-style: none;
    margin: 0;
    padding: 0;
    height: 100%;
    align-items: center;
    {% if logo_alignment == 'left' %}
    justify-content: flex-start;
    {% elsif logo_alignment == 'center' %}
    justify-content: center;
    {% else %}
    justify-content: flex-end;
    {% endif %}
  }
  
  .brand-banner__item {
    flex: 0 0 auto;
    padding: {{ logo_padding }}px;
  }
  
  .brand-banner__link {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    height: 100%;
    transition: transform 0.2s ease;
  }
  
  .brand-banner__link:hover {
    /* Hover effect removed as requested */
  }
  
  .brand-banner__item--active {
    background-color: {{ active_brand_bg_color }};
    color: #ffffff;
  }
  
  .brand-banner__item--active .brand-banner__link {
    border-bottom: 2px solid var(--color-primary);
  }
  
  /* Mobile styles */
  .brand-banner__mobile-toggle {
    display: none;
    align-items: center;
    cursor: pointer;
    padding: 0 10px;
  }
  
  .brand-banner__mobile-toggle-icon {
    width: 12px;
    height: 12px;
    margin-left: 8px;
    transition: transform 0.3s ease;
  }
  
  .brand-banner__mobile-toggle-icon.open {
    transform: rotate(180deg);
  }
  
  /* Dropdown drawer that descends from header */
  .brand-banner__drawer {
    position: absolute;
    top: 100%; /* Position below the header */
    left: 0;
    width: 100%;
    z-index: 1000;
    visibility: hidden;
    opacity: 0;
    transform: translateY(-20px);
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0s linear 0.3s;
  }
  
  .brand-banner__drawer.active {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0s linear 0s;
  }
  
  .brand-banner__drawer-overlay {
    position: fixed;
    width: 100%;
    height: 100vh;
    top: 0;
    left: 0;
    background: rgba(var(--color-foreground), 0.5);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0s linear 0.3s;
    z-index: 999;
  }
  
  .brand-banner__drawer.active .brand-banner__drawer-overlay {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.3s ease, visibility 0s linear 0s;
  }
  
  .brand-banner__drawer-inner {
    position: relative;
    width: 100%;
    background: var(--gradient-background);
    box-shadow: 0 4px 8px rgba(var(--color-shadow), 0.1);
    max-height: 80vh;
    overflow-y: auto;
  }
  
  .brand-banner__drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.08);
  }
  
  .brand-banner__drawer-heading {
    margin: 0;
    font-size: 1.2rem;
  }
  
  .brand-banner__drawer-close {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }
  
  .brand-banner__drawer-list {
    list-style: none;
    margin: 0;
    padding: 1rem 0;
  }
  
  .brand-banner__drawer-item {
    padding: 0.75rem 1.5rem;
  }
  
  .brand-banner__drawer-item--active {
    background-color: {{ active_brand_bg_color }};
  }
  
  .brand-banner__drawer-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: rgb(var(--color-foreground));
  }
  
  .brand-banner__drawer-logo {
    height: 30px;
    margin-right: 10px;
  }
  
  @media screen and (max-width: 749px) {
    .brand-banner__list-container {
      display: none;
    }
    
    .brand-banner__mobile-toggle {
      display: flex;
    }
    
    .brand-banner__container {
      justify-content: center;
    }
    
    .brand-banner__announcement {
      display: none;
    }
  }
  
  .brand-banner__logo {
    height: calc({{ banner_height }}px - {{ logo_padding | times: 2 }}px);
  }
  
  .brand-banner__name {
    font-weight: 600;
    color: {{ text_color }};
  }
</style>

<div class="brand-banner" style="background-color: {{ background_color }};">
  <div class="brand-banner__container page-width">
    <div class="brand-banner__announcement">
      {{ announcement_text }}
    </div>
    
    {% comment %} Mobile toggle button - only shows on mobile {% endcomment %}
    <div class="brand-banner__mobile-toggle" aria-expanded="false" aria-controls="BrandDrawer">
      {% comment %} Find the active brand to display in mobile view {% endcomment %}
      {% assign active_brand_found = false %}
      {% assign active_brand_logo = blank %}
      {% assign active_brand_title = 'Select Brand' %}
      
      {% for brand in shop.metaobjects.brand.values %}
        {% if brand.brand_handle != blank and selected_brand == brand.brand_handle %}
          {% assign active_brand_found = true %}
          {% assign active_brand_title = brand.title %}
          
          {% comment %} Determine which logo to display based on active state and default_logo_shade setting {% endcomment %}
          {% assign use_light_logo = false %}
          
          {% if default_logo_shade == 'light' %}
            {% if use_opposite_shade_for_active %}
              {% assign use_light_logo = false %}
            {% else %}
              {% assign use_light_logo = true %}
            {% endif %}
          {% else %}
            {% if use_opposite_shade_for_active %}
              {% assign use_light_logo = true %}
            {% else %}
              {% assign use_light_logo = false %}
            {% endif %}
          {% endif %}
          
          {% if use_light_logo %}
            {% if brand.monochrome_logo_light != blank %}
              {% assign active_brand_logo = brand.monochrome_logo_light %}
            {% else %}
              {% assign active_brand_logo = brand.logo %}
            {% endif %}
          {% else %}
            {% if brand.monochrome_logo_dark != blank %}
              {% assign active_brand_logo = brand.monochrome_logo_dark %}
            {% else %}
              {% assign active_brand_logo = brand.logo %}
            {% endif %}
          {% endif %}
          
          {% break %}
        {% endif %}
      {% endfor %}
      
      {% if active_brand_logo != blank %}
        {{ active_brand_logo | image_url: height: 30 | image_tag: 
          alt: active_brand_title,
          class: 'brand-banner__logo',
          loading: 'lazy'
        }}
      {% else %}
        <span class="brand-banner__name">{{ active_brand_title }}</span>
      {% endif %}
      
      <svg class="brand-banner__mobile-toggle-icon" viewBox="0 0 12 12" xmlns="http://www.w3.org/2000/svg">
        <path d="M10.9,3.1l-4.4,4.4L2.1,3.1C1.9,2.9,1.5,2.9,1.3,3.1c-0.2,0.2-0.2,0.5,0,0.7l5,5c0.2,0.2,0.5,0.2,0.7,0l5-5c0.2-0.2,0.2-0.5,0-0.7C11.4,2.9,11.1,2.9,10.9,3.1z" fill="currentColor"/>
      </svg>
    </div>
    
    <div class="brand-banner__list-container">
      <ul class="brand-banner__list">
      {% comment %} Access brand metaobjects using shop.metaobjects.brand.values {% endcomment %}
      {% comment %} Sort brands by sort_order if available, otherwise use title {% endcomment %}
      {% assign has_sort_order = false %}
      {% for brand in shop.metaobjects.brand.values %}
        {% if brand.sort_order != blank %}
          {% assign has_sort_order = true %}
          {% break %}
        {% endif %}
      {% endfor %}
      
      {% if has_sort_order %}
        {% assign sorted_brands = shop.metaobjects.brand.values | sort: 'sort_order' %}
      {% else %}
        {% assign sorted_brands = shop.metaobjects.brand.values | sort: 'title' %}
      {% endif %}
      
      {% for brand in sorted_brands %} 
        

           
        {% if brand.brand_handle != blank %}
          {% assign brand_handle = brand.brand_handle %}
          {% assign brand_title = brand.title %}
          {% assign brand_logo = brand.logo %}
          
          {% comment %} Try different approaches to get the URL {% endcomment %}
          {% if brand.link.value.url != blank %}
            {% assign brand_link = brand.link.value.url %}
          {% elsif brand.link.url != blank %}
            {% assign brand_link = brand.link.url %}
          {% elsif brand.link.value != blank %}
            {% assign brand_link = brand.link.value %}
          {% else %}
            {% assign brand_link = brand.link %}
          {% endif %}
          


          <li class="brand-banner__item{% if selected_brand == brand_handle %} brand-banner__item--active{% endif %}">
            <a href="{{ brand_link }}" class="brand-banner__link" data-brand-handle="{{ brand_handle }}" aria-label="Visit {{ brand_title }} brand page">
              {% comment %} Determine which logo to display based on active state and default_logo_shade setting {% endcomment %}
              {% if selected_brand == brand_handle %}
                {% assign is_active = true %}
              {% else %}
                {% assign is_active = false %}
              {% endif %}
              {% assign use_light_logo = false %}
              
              {% comment %} Determine which logo shade to use based on settings {% endcomment %}
              {% if default_logo_shade == 'light' %}
                {% if is_active and use_opposite_shade_for_active %}
                  {% comment %} Active brand uses opposite of default shade if enabled {% endcomment %}
                  {% assign use_light_logo = false %}
                {% else %}
                  {% assign use_light_logo = true %}
                {% endif %}
              {% else %}
                {% if is_active and use_opposite_shade_for_active %}
                  {% comment %} Active brand uses opposite of default shade if enabled {% endcomment %}
                  {% assign use_light_logo = true %}
                {% else %}
                  {% assign use_light_logo = false %}
                {% endif %}
              {% endif %}
              
              {% if use_light_logo %}
                {% if brand.monochrome_logo_light != blank %}
                  {% assign logo_to_display = brand.monochrome_logo_light %}
                {% else %}
                  {% assign logo_to_display = brand_logo %}
                {% endif %}
              {% else %}
                {% if brand.monochrome_logo_dark != blank %}
                  {% assign logo_to_display = brand.monochrome_logo_dark %}
                {% else %}
                  {% assign logo_to_display = brand_logo %}
                {% endif %}
              {% endif %}
              
              {% if logo_to_display != blank %}
                {% assign logo_height = banner_height | minus: logo_padding | minus: logo_padding %}
                {{ logo_to_display | image_url: height: logo_height | image_tag: 
                  alt: brand_title,
                  class: 'brand-banner__logo',
                  loading: 'lazy'
                }}
              {% else %}
                <span class="brand-banner__name">{{ brand_title }}</span>
              {% endif %}
            </a>
          </li>
        {% endif %}
      {% endfor %}
      </ul>
    </div>
  </div>
</div>

{% comment %} Brand Drawer for Mobile View {% endcomment %}
<div id="BrandDrawer" class="brand-banner__drawer">
  <div class="brand-banner__drawer-overlay"></div>
  <div class="brand-banner__drawer-inner">
    <div class="brand-banner__drawer-header">
      <h2 class="brand-banner__drawer-heading">Select Brand</h2>
      <button class="brand-banner__drawer-close" aria-label="Close brand menu">
        <svg width="16" height="16" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
          <path d="M15.1,3.1l-4,4l4,4c0.3,0.3,0.3,0.7,0,0.9c-0.3,0.3-0.7,0.3-0.9,0l-4-4l-4,4c-0.3,0.3-0.7,0.3-0.9,0 c-0.3-0.3-0.3-0.7,0-0.9l4-4l-4-4c-0.3-0.3-0.3-0.7,0-0.9c0.3-0.3,0.7-0.3,0.9,0l4,4l4-4c0.3-0.3,0.7-0.3,0.9,0 C15.3,2.4,15.3,2.8,15.1,3.1z" fill="currentColor"/>
        </svg>
      </button>
    </div>
    
    <ul class="brand-banner__drawer-list">
      {% for brand in sorted_brands %}
        {% if brand.brand_handle != blank %}
          {% assign brand_handle = brand.brand_handle %}
          {% assign brand_title = brand.title %}
          {% assign brand_logo = brand.logo %}
          
          {% comment %} Try different approaches to get the URL {% endcomment %}
          {% if brand.link.value.url != blank %}
            {% assign brand_link = brand.link.value.url %}
          {% elsif brand.link.url != blank %}
            {% assign brand_link = brand.link.url %}
          {% elsif brand.link.value != blank %}
            {% assign brand_link = brand.link.value %}
          {% else %}
            {% assign brand_link = brand.link %}
          {% endif %}
          
          {% comment %} Determine which logo to display based on active state and default_logo_shade setting {% endcomment %}
          {% if selected_brand == brand_handle %}
            {% assign is_active = true %}
          {% else %}
            {% assign is_active = false %}
          {% endif %}
          {% assign use_light_logo = false %}
          
          {% comment %} Determine which logo shade to use based on settings {% endcomment %}
          {% if default_logo_shade == 'light' %}
            {% if is_active and use_opposite_shade_for_active %}
              {% comment %} Active brand uses opposite of default shade if enabled {% endcomment %}
              {% assign use_light_logo = false %}
            {% else %}
              {% assign use_light_logo = true %}
            {% endif %}
          {% else %}
            {% if is_active and use_opposite_shade_for_active %}
              {% comment %} Active brand uses opposite of default shade if enabled {% endcomment %}
              {% assign use_light_logo = true %}
            {% else %}
              {% assign use_light_logo = false %}
            {% endif %}
          {% endif %}
          
          {% if use_light_logo %}
            {% if brand.monochrome_logo_light != blank %}
              {% assign logo_to_display = brand.monochrome_logo_light %}
            {% else %}
              {% assign logo_to_display = brand_logo %}
            {% endif %}
          {% else %}
            {% if brand.monochrome_logo_dark != blank %}
              {% assign logo_to_display = brand.monochrome_logo_dark %}
            {% else %}
              {% assign logo_to_display = brand_logo %}
            {% endif %}
          {% endif %}
          
          <li class="brand-banner__drawer-item{% if selected_brand == brand_handle %} brand-banner__drawer-item--active{% endif %}">
            <a href="{{ brand_link }}" class="brand-banner__drawer-link" data-brand-handle="{{ brand_handle }}" aria-label="Visit {{ brand_title }} brand page">
              {% if logo_to_display != blank %}
                {{ logo_to_display | image_url: height: 30 | image_tag: 
                  alt: brand_title,
                  class: 'brand-banner__drawer-logo',
                  loading: 'lazy'
                }}
              {% endif %}
              <span>{{ brand_title }}</span>
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</div>

{% comment %} JavaScript for brand drawer functionality {% endcomment %}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const brandDrawer = document.getElementById('BrandDrawer');
    const brandDrawerOverlay = document.querySelector('.brand-banner__drawer-overlay');
    const brandDrawerClose = document.querySelector('.brand-banner__drawer-close');
    
    // Find the header logo link to use as the toggle
    const headerLogoLink = document.querySelector('.header__heading-link');
    
    // Function to position the drawer below the header logo
    function positionDrawer() {
      if (!isMobile() || !headerLogoLink) return;
      
      const headerRect = headerLogoLink.getBoundingClientRect();
      const headerHeight = document.querySelector('header').offsetHeight;
      
      // Position the drawer below the header
      brandDrawer.style.top = `${headerHeight}px`;
    }
    
    // Function to open the drawer
    function openDrawer() {
      positionDrawer();
      brandDrawer.classList.add('active');
      if (headerLogoLink) {
        headerLogoLink.setAttribute('aria-expanded', 'true');
      }
    }
    
    // Function to close the drawer
    function closeDrawer() {
      brandDrawer.classList.remove('active');
      if (headerLogoLink) {
        headerLogoLink.setAttribute('aria-expanded', 'false');
      }
    }
    
    // Check if we're on mobile
    function isMobile() {
      return window.innerWidth <= 749;
    }
    
    // Create and add the dropdown icon to the header logo
    function addDropdownToLogo() {
      if (!isMobile()) return; // Only add on mobile
      
      // Remove any existing dropdown icons first
      const existingIcons = document.querySelectorAll('.brand-dropdown-icon-container');
      existingIcons.forEach(icon => icon.remove());
      
      const logoWrapper = document.querySelector('.header__heading-logo-wrapper');
      if (logoWrapper) {
        const dropdownIcon = document.createElement('div');
        dropdownIcon.className = 'brand-dropdown-icon-container';
        dropdownIcon.innerHTML = `<svg class="brand-dropdown-icon" width="12" height="12" viewBox="0 0 12 12" xmlns="http://www.w3.org/2000/svg" style="margin-left: 8px; vertical-align: middle;">
          <path d="M10.9,3.1l-4.4,4.4L2.1,3.1C1.9,2.9,1.5,2.9,1.3,3.1c-0.2,0.2-0.2,0.5,0,0.7l5,5c0.2,0.2,0.5,0.2,0.7,0l5-5c0.2-0.2,0.2-0.5,0-0.7C11.4,2.9,11.1,2.9,10.9,3.1z" fill="currentColor"/>
        </svg>`;
        dropdownIcon.style.display = 'inline-block';
        logoWrapper.parentNode.insertBefore(dropdownIcon, logoWrapper.nextSibling);
      }
    }
    
    // Handle logo click based on screen size
    if (headerLogoLink) {
      headerLogoLink.addEventListener('click', function(event) {
        // Only prevent navigation and toggle drawer on mobile
        if (isMobile()) {
          event.preventDefault(); // Prevent navigation
          
          if (brandDrawer.classList.contains('active')) {
            closeDrawer();
          } else {
            openDrawer();
          }
        }
      });
      
      // Initial setup
      if (isMobile()) {
        headerLogoLink.style.cursor = 'pointer';
        addDropdownToLogo();
      }
      
      // Update on window resize
      window.addEventListener('resize', function() {
        if (isMobile()) {
          headerLogoLink.style.cursor = 'pointer';
          addDropdownToLogo();
        } else {
          headerLogoLink.style.cursor = '';
          const icons = document.querySelectorAll('.brand-dropdown-icon-container');
          icons.forEach(icon => icon.remove());
        }
      });
    }
    
    // Close drawer when clicking the overlay
    brandDrawerOverlay.addEventListener('click', closeDrawer);
    
    // Close drawer when clicking the close button
    brandDrawerClose.addEventListener('click', closeDrawer);
    
    // Close drawer when pressing Escape key
    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape' && brandDrawer.classList.contains('active')) {
        closeDrawer();
      }
    });
  });
</script>

<style>
  /* Additional styles for the header logo dropdown functionality */
  @media screen and (max-width: 749px) {
    .header__heading-link {
      display: flex;
      align-items: center;
    }
    
    .brand-dropdown-icon {
      transition: transform 0.3s ease;
    }
    
    .header__heading-link[aria-expanded="true"] + .brand-dropdown-icon-container .brand-dropdown-icon {
      transform: rotate(180deg);
    }
  }
</style>

