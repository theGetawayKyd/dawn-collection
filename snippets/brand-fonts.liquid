{% comment %}
  Dynamic brand-specific font styles
  Usage: Include in theme.liquid head section
  Requires: selected_brand variable to be set
{% endcomment %}


{% if selected_brand != blank and use_brand_fonts %}
  {% assign brand_heading_font = '' %}
  {% assign brand_body_font = '' %}
  {% assign brand_heading_weight = '' %}
  {% assign brand_body_weight = '' %}
  {% assign brand_heading_style = '' %}
  {% assign brand_body_style = '' %}
  
  {% for brand in shop.metaobjects.brand.values %}
    {% if brand.brand_handle == selected_brand %}
      {% if brand.heading_font_family != blank %}
        {% assign brand_heading_font = brand.heading_font_family %}
      {% endif %}
      
      {% if brand.body_font_family != blank %}
        {% assign brand_body_font = brand.body_font_family %}
      {% endif %}
      
      {% if brand.heading_font_weight != blank %}
        {% assign brand_heading_weight = brand.heading_font_weight %}
      {% endif %}
      
      {% if brand.body_font_weight != blank %}
        {% assign brand_body_weight = brand.body_font_weight %}
      {% endif %}
      
      {% if brand.heading_font_style != blank %}
        {% assign brand_heading_style = brand.heading_font_style %}
      {% endif %}
      
      {% if brand.body_font_style != blank %}
        {% assign brand_body_style = brand.body_font_style %}
      {% endif %}
      
      {% break %}
    {% endif %}
  {% endfor %}
  

  <style id="brand-specific-fonts">
    {% if brand_heading_font != blank %}
    /* Brand-specific heading font family */
    html body h1, 
    html body h2, 
    html body h3, 
    html body h4, 
    html body h5, 
    html body h6,
    html body .h1, 
    html body .h2, 
    html body .h3, 
    html body .h4, 
    html body .h5, 
    html body .h6,
    html body .header__heading,
    html body .title {
      font-family: {{ brand_heading_font }};
      {% if brand_heading_weight != blank %}font-weight: {{ brand_heading_weight }};{% endif %}
      {% if brand_heading_style != blank %}font-style: {{ brand_heading_style }};{% endif %}
    }
    {% endif %}
    
    {% if brand_body_font != blank %}
    /* Brand-specific body font family */
    html body,
    html body p,
    html body .body-font,
    html body .button,
    html body .product__title,
    html body .price {
      font-family: {{ brand_body_font }};
      {% if brand_body_weight != blank %}font-weight: {{ brand_body_weight }};{% endif %}
      {% if brand_body_style != blank %}font-style: {{ brand_body_style }};{% endif %}
    }
    {% endif %}
  </style>
{% endif %}
